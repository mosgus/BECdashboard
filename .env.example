# ============================================================
# Blue Eagle — environment variables
# ============================================================
# Setup:
#   cp .env.example .env
#   Edit values as needed, then start backend and frontend.
# ============================================================

# ── Auth (optional write-key gate) ────────────────────────────────────────────
# Leave unset for open cohort access (anyone can submit analysis requests).
# Set to protect public deployments — all mutation requests must include
# the matching X-Class-Key header.
# CLASS_WRITE_KEY=your-shared-key-here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://blueeagle:blueeagle@localhost:5432/blueeagle

# ── Frontend build ────────────────────────────────────────────────────────────
# Baked into the JS bundle at build time.
# For production: set to your public backend URL (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional ──────────────────────────────────────────────────────────────────
# Restrict CORS origins in production (comma-separated, no spaces)
# CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Data provider: yfinance (default) | bloomberg (stub — not yet implemented)
# DATA_PROVIDER=yfinance
